# Backend
# PostgreSQL connection (host-based dev). With docker-compose the backend
# service uses the internal hostname `postgres` on port 5432; see compose file.
DATABASE_URL=postgresql+psycopg://poker:poker@localhost:5433/poker_icm_coach

# CORS: comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080,https://icm-master-frontend.onrender.com

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Game defaults (overridable)
STARTING_STACK=45000
STARTING_SMALL_BLIND=100
STARTING_BIG_BLIND=100
BLIND_LEVEL_MINUTES=20
FAST_MODE=false

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/table
