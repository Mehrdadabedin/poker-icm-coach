# Backend
# PostgreSQL connection (host-based dev). With docker-compose the backend
# service uses the internal hostname `postgres` on port 5432; see compose file.
DATABASE_URL=postgresql+psycopg://poker:poker@localhost:5433/poker_icm_coach

# CORS: comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080,https://icm-master-frontend.onrender.com

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Optional best-effort hand-history persistence dir (A07); blank disables.
HISTORY_DIR=data/history

# Optional best-effort auth persistence; blank disables (A18).
AUTH_USERS_FILE=data/users.json
AUTH_SESSIONS_FILE=data/sessions.json
# Where accounts and logins live: "file" (the two files above) or "database"
# (DATABASE_URL). Use "database" on Render: its disk is wiped on every deploy.
# With "database", the files above only fill an empty database once.
AUTH_STORAGE=file

# Google sign-in. Both values are required; /api/auth/providers reports
# google=false while either is blank. Secrets live only in the environment:
# never commit a real client secret, never echo it from an endpoint.
# Google Cloud console authorized redirect URI must be the callback below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional public backend callback override, e.g.
# https://icm-master-backend.onrender.com/api/auth/google/callback
# Blank derives it from the request (X-Forwarded-Proto / X-Forwarded-Host),
# which is the correct behaviour behind Render's TLS-terminating proxy.
GOOGLE_REDIRECT_URI=

# Initial Admin account, created once at startup and forced to change its
# password on first login. Blank or shorter than 12 characters: no Admin.
ADMIN_BOOTSTRAP_PASSWORD=

# Rate limits (plan 109). Keep off until TRUSTED_PROXY_HOPS is right for the host,
# or everyone behind the host's proxy counts as one visitor.
RATE_LIMITS_ENABLED=false
# Number of proxies in front of the app. 0 ignores X-Forwarded-For. Find the value
# with RATE_LIMIT_LOG_CLIENT_IP=true: sign in from two networks and read the log.
# Never use FORWARDED_ALLOW_IPS=*: uvicorn then lets a visitor choose the address.
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_LOG_CLIENT_IP=false
# "log" records who would be blocked, "enforce" blocks. Sign-in and sign-up always block.
RATE_LIMIT_COACH_MODE=log
# count/seconds. Starting points, not measured traffic.
RATE_LIMIT_LOGIN_PAIR=5/900
RATE_LIMIT_LOGIN_IP=30/900
RATE_LIMIT_SIGNUP_ATTEMPTS=20/3600
RATE_LIMIT_SIGNUP_HOUR=5/3600
RATE_LIMIT_SIGNUP_DAY=20/86400
RATE_LIMIT_GOOGLE=30/60
RATE_LIMIT_COACH_TABLE=120/60
RATE_LIMIT_COACH_PAGE_MINUTE=30/60
RATE_LIMIT_COACH_PAGE_DAY=1000/86400

# Game defaults (overridable)
STARTING_STACK=45000
STARTING_SMALL_BLIND=100
STARTING_BIG_BLIND=100
BLIND_LEVEL_MINUTES=20
FAST_MODE=false

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/table
