#!/bin/sh
# Runs the same gates as .github/workflows/ci.yml before a push.
#
# Enable it once per clone (hooks are not copied by git clone):
#   git config core.hooksPath .githooks
#
# It runs on push, not commit: the backend suite takes about 30 seconds, which
# is too slow to pay on every commit and cheap to pay once per push.
# Skip deliberately with `git push --no-verify` when you know why.
set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

# Part 1: refuse to push this repository anywhere but its own remote.
# git invokes pre-push as: pre-push <remote-name> <remote-url>
remote_url="${2:-}"
# Normalise every remote form down to github.com/... or github.com:... before
# matching. The scheme goes first, then any userinfo, because a personal access
# token remote reads https://user:token@github.com/... and would otherwise look
# like a foreign host.
bare_url="${remote_url#*://}"
bare_url="${bare_url#*@}"
case "$bare_url" in
  github.com/Mehrdadabedin/poker-icm-coach|github.com/Mehrdadabedin/poker-icm-coach.git|\
  github.com:Mehrdadabedin/poker-icm-coach|github.com:Mehrdadabedin/poker-icm-coach.git) ;;
  *)
    echo "pre-push: refusing, the push URL is not this repository's own remote" >&2
    echo "          remote:   ${1:-?}" >&2
    echo "          url:      $remote_url" >&2
    echo "          expected: github.com/Mehrdadabedin/poker-icm-coach" >&2
    exit 1
    ;;
esac

# Part 2: no direct pushes to main. Every change reaches main through a pull
# request, so the merge is reviewable and reversible. This is a local stopgap:
# the repository has no server-side branch protection (that needs admin rights
# on github.com/Mehrdadabedin/poker-icm-coach), and any clone that has not run
# scripts/install-hooks.sh is not covered at all.
# git passes one line per ref on stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
ZERO='0000000000000000000000000000000000000000'
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) ;;
    *) continue ;;
  esac
  branch="${remote_ref#refs/heads/}"

  if [ "$local_sha" = "$ZERO" ]; then
    echo "pre-push: blocked deletion of '$branch'" >&2
  elif [ "$remote_sha" != "$ZERO" ] &&
       git cat-file -e "$remote_sha" 2>/dev/null &&
       ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: blocked force-push to '$branch'" >&2
  else
    echo "pre-push: blocked direct push to '$branch'" >&2
  fi
  echo "          open a pull request instead:" >&2
  echo "          git switch -c <branch> && git push -u origin <branch> && gh pr create" >&2
  echo "          bypass, and say why in the commit message: git push --no-verify" >&2
  exit 1
done

echo "pre-push: backend lint"
(cd backend && uv run ruff check app tests)

echo "pre-push: backend types"
(cd backend && uv run mypy app)

echo "pre-push: backend tests"
(cd backend && uv run pytest -q)

echo "pre-push: frontend types and lint"
(cd frontend && npx tsc --noEmit && npx oxlint --deny-warnings)

echo "pre-push: frontend tests"
(cd frontend && npx vitest run)

echo "pre-push: frontend build"
(cd frontend && npx vite build >/dev/null)

# The four database tests skip without PostgreSQL, so a green local run is not
# the same as a green CI run. Say so rather than let it pass unnoticed.
if ! (cd backend && uv run python -c "
import sys
from sqlalchemy.exc import SQLAlchemyError
from app.database.session import engine
try:
    engine.connect().close()
except SQLAlchemyError:
    sys.exit(1)
" 2>/dev/null); then
  echo "pre-push: WARNING 4 database tests skipped (no PostgreSQL)."
  echo "           docker compose up -d postgres && cd backend && uv run alembic upgrade head"
fi

echo "pre-push: all gates passed"
